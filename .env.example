# Database Configuration
# If deploying on Railway, these are usually provided automatically by the MySQL plugin.
MYSQLHOST=127.0.0.1
MYSQLUSER=root
MYSQLPASSWORD=
MYSQLDATABASE=railway
MYSQLPORT=3306

# Or full connection URL (Railway often provides this as MYSQL_URL or DATABASE_URL):
# MYSQL_URL=mysql://root:password@host:port/database

# Google Gemini AI API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
